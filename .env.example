# Copy this file to .env and fill in your key. Everything else is optional.
OPENAI_API_KEY=

# Models. Defaults are the fastest and cheapest options as of September 2026.
ANSWER_MODEL=gpt-6-luna
ANSWER_REASONING_EFFORT=none
ANSWER_MAX_TOKENS=400
# "Answer in details" and typed questions: a stronger model that thinks briefly. If no words appear within
# DETAIL_THINK_SECONDS, the thinking run is dropped and ANSWER_MODEL writes the detailed answer instead.
DETAIL_MODEL=gpt-6-sol
DETAIL_REASONING_EFFORT=low
DETAIL_THINK_SECONDS=5
NOTES_MODEL=gpt-6-luna
NOTES_REASONING_EFFORT=none
BRIEF_MODEL=gpt-6-luna
BRIEF_REASONING_EFFORT=low
# gpt-4o-mini-transcribe ($0.003/min) or gpt-transcribe ($0.0045/min, more accurate).
# gpt-live-transcribe is not supported: it needs client-side turn detection.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Leave a *_REASONING_EFFORT blank when using a non-reasoning model such as gpt-4.1-mini.

# Silence (ms) that ends a speaker's turn. Lower answers sooner but may cut people off mid-sentence.
VAD_SILENCE_MS=500
VAD_THRESHOLD=0.5

# Documents (other than past transcripts) up to this size (estimated tokens) go into every prompt in full,
# next to the prep pack. Larger ones are searched instead. Past transcripts are always searched.
FULL_TEXT_TOKEN_LIMIT=15000
# Most material (estimated tokens) sent to write the prep pack. Larger material is trimmed evenly.
PACK_INPUT_TOKEN_LIMIT=120000

# true: phones and tablets on your network can open the page with the access code.
# false: only this computer can open it.
LAN_ACCESS=true
# Fixed access code for other devices. Leave blank for a new random 6-digit code on every start.
ACCESS_CODE=
PORT=8000
